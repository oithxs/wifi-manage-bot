# compose.yml と Bot が読む環境変数。このファイルを .env としてコピーして埋める。
# 秘密 (トークン類) は絶対にコミットしないこと
#
# --- Docker Compose のマウントと権限 (ホスト側の実環境に合わせる) ---
# アカウントリング DB (FreeRADIUS の rlm_sql_sqlite が書く)
WIFI_RADIUS_DB_HOST=/var/lib/freeradius/radius.sqlite
# 部員証明書に署名するローカル CA (ca.crt / ca.key) のあるディレクトリ
WIFI_CA_DIR_HOST=/etc/freeradius/3.0/certs
# 証明書の serial 記録ディレクトリ (FreeRADIUS 側の wifi-cert-check と共有)
WIFI_SERIAL_DIR_HOST=/var/lib/wifi-certs
# 発行した p12 の受け渡しディレクトリ
WIFI_ISSUED_DIR_HOST=/opt/wifi-bot/issued
# コンテナを動かす uid/gid。ホストの wifi-bot ユーザーに合わせる
# (id -u wifi-bot / id -g wifi-bot)。FREERAD_GID は getent group freerad の gid
WIFI_BOT_UID=999
WIFI_BOT_GID=999
FREERAD_GID=104

# --- Discord ---
WIFI_DISCORD_BOT_TOKEN=
WIFI_DISCORD_GUILD_ID=

# --- Authentik API (/wifi-cert の発行認可) ---
WIFI_AUTHENTIK_URL=https://auth.example.com
WIFI_AUTHENTIK_API_TOKEN=
WIFI_AUTHENTIK_SOURCE_SLUG=discord
WIFI_TOKEN_PREFIX=wifi-

# --- .mobileconfig の Wi-Fi 設定 ---
WIFI_SSID=HxS-AirLAN
WIFI_RADIUS_VERIFY_NAME=radius.example.com

# --- 証明書発行 (helper: wifi-cert-issue) ---
WIFI_CERT_DAYS=365
WIFI_P12_PASSWORDLESS=0
