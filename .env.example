# compose.yml と Bot が読む環境変数。このファイルを .env としてコピーして埋める。
# 秘密 (トークン類) は絶対にコミットしないこと
#
# --- Docker Compose のマウントと権限 (ホスト側の実環境に合わせる) ---
# アカウントリング DB (FreeRADIUS の rlm_sql_sqlite が書く)
WIFI_RADIUS_DB_HOST=/var/lib/freeradius/radius.sqlite
# Wi-Fi トークンの発行で Bot が書き換える users ファイルのディレクトリ
# (FreeRADIUS の mods-config/files。Bot は freerad グループ (0770) で書き込む)
WIFI_USERS_DIR_HOST=/etc/freeradius/3.0/mods-config/files
# コンテナを動かす uid/gid。ホストの wifi-manage-bot ユーザーに合わせる
# (id -u wifi-manage-bot / id -g wifi-manage-bot)。FREERAD_GID は getent group freerad の gid
WIFI_BOT_UID=999
WIFI_BOT_GID=999
FREERAD_GID=104

# --- Discord ---
WIFI_DISCORD_BOT_TOKEN=
WIFI_DISCORD_GUILD_ID=

# --- Authentik API (/wifi の認可とパスワードの取得) ---
WIFI_AUTHENTIK_URL=https://auth.example.com
WIFI_AUTHENTIK_API_TOKEN=
WIFI_AUTHENTIK_SOURCE_SLUG=discord
WIFI_TOKEN_PREFIX=wifi-

# --- Wi-Fi トークンの自動発行 (provision.go) ---
# この Authentik グループの有効なユーザーのトークンを Bot が発行・管理する。
# 空のときは発行しない (読み取り専用の Bot として動く)
WIFI_MEMBER_GROUP=hxs-members
# 同期の間隔 (取ってこられなくても次の周期で直る)
WIFI_PROVISION_INTERVAL=10m
# この Bot が管理するトークンの description。iac の roles/radius と同じ値を使う
# (一致しているトークンだけを管理する)
WIFI_TOKEN_DESCRIPTION=Wi-Fi password, managed by roles/radius
# Authentik の Webhook を受け取るときのトークン (iac の roles/authentik と同じ値)。
# 空のときは定期同期だけを行う
WIFI_WEBHOOK_TOKEN=
# Webhook の待ち受けアドレス (コンテナ内)
WIFI_WEBHOOK_LISTEN=:8080
# ホスト側の待ち受け (compose の ports)。Tailscale の IP にすると tailnet だけに公開する
WIFI_WEBHOOK_BIND=127.0.0.1
WIFI_WEBHOOK_PORT=8082

# --- /wifi の返信の案内に出す SSID ---
WIFI_SSID=HxS-AirLAN
